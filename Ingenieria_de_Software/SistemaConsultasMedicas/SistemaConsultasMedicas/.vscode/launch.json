{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Ejecutar Sistema (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "env": { "PYTHONIOENCODING": "utf-8" }
        },
        {
            "name": "Depurar Sistema (con breakpoints)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "env": { "PYTHONIOENCODING": "utf-8" }
        }
    ]
}
